## Backend env example (DO NOT put secrets here)

### App
PORT=3001
DATABASE_URL="postgresql://user:password@localhost:5432/driver_license_dev?schema=public"

### Uploads
UPLOAD_DIR=./uploads

### PDF assets
PDF_TEMPLATE_PATH=./assets/templates/idp-dev-template.pdf
PDF_FONT_PATH=./assets/fonts/NotoSans-Regular.ttf

### Verify module
VERIFY_TTL_MS=3600000
VERIFY_CLEANUP_MS=600000
VERIFY_OCR_MAX_ATTEMPTS=5

### Face match
FACE_MATCH_SIMILARITY_THRESHOLD=85

### AWS Rekognition (optional, for face verification)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

### Resend email
RESEND_API_KEY=
RESEND_FROM=noreply@idpcompanion.com
RESEND_REPLY_TO=support@idpcompanion.com
RESEND_TIMEOUT_MS=8000
RESEND_MAX_ATTEMPTS=3

### Dev-only: send email after successful POST /api/applications
EMAIL_SEND_ON_APPLICATION_CREATE=0

### Optional: show logo in email signature (hosted image URL)
EMAIL_LOGO_URL=

### Optional: inline repo logo SVG in signature (no hosting needed)
# Note: some email clients may not display data:image/* URLs (Gmail often blocks them).
EMAIL_LOGO_INLINE=0
# Path is resolved from apps/backend working directory (process.cwd())
EMAIL_LOGO_ASSET_PATH=../../packages/ui-kit/assets/branding/logo_1_black.svg

### Recommended: public backend base URL to serve logo from /api/email/logo.svg
# Use your Railway URL in production.
EMAIL_PUBLIC_BASE_URL=http://localhost:3001

### Optional: product URL shown in email footer
PRODUCT_URL=https://idpcompanion.com
REQUIRE_PAYMENT_FOR_PDF=false
