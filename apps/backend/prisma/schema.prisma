generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  male
  female
}

enum ApplicationStatus {
  created
  paid
  pdf_ready
}

enum LicenseCategory {
  A
  B
  C
  D
  E
}

model Application {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  email     String
  phone     String?

  firstName String
  lastName  String

  issueCountry String

  dobDay   Int
  dobMonth Int
  dobYear  Int

  sex      Sex
  planYears Int

  licenseNumber     String?
  licenseCategories LicenseCategory[]

  signatureDataUrl String @db.Text
  verificationId   String

  headshotPath         String
  headshotOriginalName String
  headshotMimeType     String
  headshotSize         Int

  status ApplicationStatus @default(created)

  @@index([createdAt])
}
