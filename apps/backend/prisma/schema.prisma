generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  male
  female
}

enum ApplicationStatus {
  created
  paid
  pdf_ready
}

enum LicenseCategory {
  A
  B
  C
  D
  E
}

enum PaymentProvider {
  gumroad
  nowpayments
}

enum PaymentStatus {
  pending
  confirmed
  failed
  expired
}

model Application {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  email     String
  phone     String?

  firstName String
  lastName  String

  issueCountry String

  dobDay   Int
  dobMonth Int
  dobYear  Int

  sex      Sex
  planYears Int

  licenseNumber     String?
  licenseCategories LicenseCategory[]

  signatureDataUrl String @db.Text
  verificationId   String

  headshotPath         String
  headshotOriginalName String
  headshotMimeType     String
  headshotSize         Int

  status ApplicationStatus @default(created)

  payments Payment[]

  @@index([createdAt])
}

model Payment {
  id            String          @id @default(uuid())
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  provider      PaymentProvider
  externalId    String?
  amountCents   Int
  currency      String          @default("USD")
  status        PaymentStatus   @default(pending)

  rawPayload    Json?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([provider, externalId])
  @@index([applicationId])
  @@index([status])
}
