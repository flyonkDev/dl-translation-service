{
	"name": "driver-license-monorepo",
	"private": true,
	"packageManager": "pnpm@10.32.1",
	"pnpm": {
		"overrides": {
			"@nuxt/nitro-server": "4.4.2"
		},
		"onlyBuiltDependencies": [
			"@nestjs/core",
			"@parcel/watcher",
			"@prisma/client",
			"@prisma/engines",
			"esbuild",
			"prisma",
			"puppeteer",
			"sharp",
			"tesseract.js",
			"unrs-resolver",
			"vue-demi"
		]
	},
	"scripts": {
		"dev": "pnpm -r --parallel dev",
		"build": "pnpm -r build",
		"lint": "pnpm -r lint",
		"dev:frontend": "pnpm --filter frontend dev",
		"dev:backend": "pnpm --filter backend start:dev"
	}
}
